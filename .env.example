NEXT_PUBLIC_SUPABASE_URL=https://xlbddrjzrrpxsarppxky.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Apenas server-side — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Produção: deixe false ou omita (login só via Supabase Auth)
# Desenvolvimento local: true
ENABLE_DEV_LOGIN=false

# Opcional: npm run configure:auth-urls (Account → Access Tokens)
# SITE_URL=https://integraeduc224.com.br
# EXTRA_SITE_URLS=https://www.integraeduc224.com.br,https://plataforma-educacao-tawny.vercel.app
# SUPABASE_ACCESS_TOKEN=seu-access-token

# IA — configure pelo menos uma chave (opcional)
AI_PROVIDER=openai
OPENAI_API_KEY=sua-chave-openai
OPENAI_MODEL=gpt-4o-mini

# Alternativa: Google Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=sua-chave-gemini
# GEMINI_MODEL=gemini-2.0-flash
